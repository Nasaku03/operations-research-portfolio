Set j 'Variables' /1*20/;
Set i 'Constraints' /1*10/;
Parameters
    A(i, j) 'matrix of constraints'
    b(i) 'second Member vector'
    nHl(j) 'new Hl'
    uppers(j) 'upper bounds of variables'
    lowers(j) 'lower bounds of variables';
Scalar nHl_SM 'new Second member of Hl';
Variables
    x(j) 'principle variables'
    obj 'Objective';
Positive Variables
    epsilon 'epsilon';
Integer Variable x;
Equations
    ff'Objective function'
    const(i)'Principle constraints'
    up(j)'Upper bounds'
    lo(j)'Lower bounds'
    nec'new efficient cut';
ff..    obj =e= epsilon;
const(i)..sum(j, A(i, j) * x(j)) =l= b(i);
up(j)..x(j) =l= uppers(j);
lo(j)..x(j) =g= lowers(j);
nec..   sum(j, nHl(j)*x(j)) =e= nHl_SM - epsilon;
